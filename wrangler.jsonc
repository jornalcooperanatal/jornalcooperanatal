{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jornal-coopera-natal",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jornal-coopera-natal",
      "database_id": "COLOQUE_AQUI_O_DATABASE_ID"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "jornal-coopera-natal-media"
    }
  ]
}